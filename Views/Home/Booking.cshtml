@model List<Dictionary<string, string>>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Rental Management | ApexAUTO</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://fonts.googleapis.com/css?family=Poppins:200,300,400,500,600,700,800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/open-iconic-bootstrap.min.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark ftco_navbar bg-dark ftco-navbar-light" id="ftco-navbar">
        <div class="container">
            <a class="navbar-brand" href="/">Apex<span>Auto</span></a>
            <div class="collapse navbar-collapse" id="ftco-nav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item"><a href="/" class="nav-link">Home</a></li>
                    <li class="nav-item"><a href="/Home/Cars" class="nav-link">Cars</a></li>
                    <li class="nav-item active"><a href="/Home/Booking" class="nav-link">Rental</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="hero-wrap hero-wrap-2 js-fullheight" style="background-image: url('/foto/audi.jpg');" data-stellar-background-ratio="0.5">
        <div class="overlay"></div>
        <div class="container">
            <div class="row no-gutters slider-text js-fullheight align-items-end justify-content-start">
                <div class="col-md-9 ftco-animate pb-5">
                    <h1 class="mb-3 bread">Rental Management Panel</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="ftco-section bg-light">
        <div class="container">

            <div class="card p-4 mb-4 shadow-sm">
                <form action="/Home/Booking" method="get" class="form-inline">
                    <div class="form-group mb-2 w-70">
                        <input type="text" name="aramaMetni" class="form-control w-100" placeholder="Müşteri TC Kimlik No Girin (Index Arama Testi)">
                    </div>
                    <button type="submit" class="btn btn-primary mb-2 ml-3">Sorgula (Hızlı Index Arama)</button>
                    <a href="/Home/Booking" class="btn btn-secondary mb-2 ml-2">Temizle</a>
                </form>
            </div>

            <div class="card p-4 shadow-sm">
                <h3 class="mb-4">Aktif Kiralamalar Listesi (vw_RentalDetails View Yapısı)</h3>
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-dark">
                            <tr>
                                <th>Kiralama ID</th>
                                <th>Müşteri Ad Soyad</th>
                                <th>Telefon</th>
                                <th>Araç Bilgisi</th>
                                <th>Plaka</th>
                                <th>Alınan Şube</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th>İşlem (Trigger Tetikleme)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Count == 0)
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">Aktif kiralama kaydı bulunamadı veya TC eşleşmedi.</td>
                                </tr>
                            }
                            @foreach (var kira in Model)
                            {
                                <tr>
                                    <td>#@kira["RentID"]</td>
                                    <td><strong>@kira["Musteri"]</strong></td>
                                    <td>@kira["Telefon"]</td>
                                    <td>@kira["Arac"]</td>
                                    <td><span class="badge badge-secondary p-2">@kira["Plaka"]</span></td>
                                    <td>@kira["Sube"]</td>
                                    <td>@kira["Baslangic"]</td>
                                    <td>@kira["Bitis"]</td>
                                    <td>
                                        <form action="/Home/KiralamaSil" method="post" style="display:inline;">
                                            <input type="hidden" name="rentID" value="@kira["RentID"]" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Araç teslim alınsın ve veritabanından silinsin mi?')">
                                                Teslim Al (Sil)
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </section>

    <footer class="ftco-footer ftco-bg-dark ftco-section">
        <div class="container text-center">
            <p>ApexAUTO - Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/main.js"></script>
</body>
</html>